# Copie para .env e ajuste. O .env NÃO vai para o Git (está no .gitignore).

# --- Banco (lidas pelo docker compose para criar o PostgreSQL) ---
POSTGRES_USER=eletrohidro
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=eletrohidro
# Porta exposta no seu computador (5433 evita conflito com outro Postgres local)
POSTGRES_PORT=5433
# Fuso de operação dos containers (API e banco): "hoje", vencimentos e filtros por dia
FUSO_HORARIO=America/Sao_Paulo

# --- Aplicação rodando FORA do Docker (uvicorn local, pytest, alembic) ---
# Dentro do compose, o serviço "api" sobrescreve o host para "db".
DATABASE_URL=postgresql+psycopg://eletrohidro:troque_esta_senha@localhost:5433/eletrohidro

# --- Usuário SOMENTE LEITURA do banco (usado pela IA; criado por docker/initdb/01-somente-leitura.sh) ---
READONLY_DB_PASSWORD=troque_esta_senha_ro
DATABASE_URL_READONLY=postgresql+psycopg://eletrohidro_ro:troque_esta_senha_ro@localhost:5433/eletrohidro

# --- IA (opcional: sem ANTHROPIC_API_KEY só o POST /ia/perguntar fica indisponível) ---
ANTHROPIC_API_KEY=
# Qualquer modelo Claude: p.ex. claude-sonnet-5-5 (mais barato) ou claude-haiku-5-5 (mais barato ainda)
ANTHROPIC_MODEL=claude-opus-5-5
IA_MAX_LINHAS=100
IA_TIMEOUT_SEGUNDOS=5
